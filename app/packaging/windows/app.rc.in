#include <winver.h>
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/FrameKeeper.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "FrameKeeper contributors"
      VALUE "FileDescription", "FrameKeeper"
      VALUE "FileVersion", "@FK_VERSION@"
      VALUE "InternalName", "FrameKeeper"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "FrameKeeper.exe"
      VALUE "ProductName", "FrameKeeper"
      VALUE "ProductVersion", "@FK_VERSION@"
      VALUE "Comments", "commit @FK_GIT_SHA@, build @FK_BUILD_ID@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
