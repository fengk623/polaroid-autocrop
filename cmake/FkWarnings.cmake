function(fk_set_warnings target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /wd4244 /wd4267 /wd4996)
    if(FK_WERROR)
      target_compile_options(${target} PRIVATE /WX)
    endif()
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wshadow -Wno-sign-compare)
    if(FK_WERROR)
      target_compile_options(${target} PRIVATE -Werror)
    endif()
  endif()
endfunction()
